# Runtime state — regenerated by hooks each session (roster, footprint log,
# active marker, handoff). Only the placeholder keeps the dir in git.
state/*
!state/.gitkeep

# Editor / OS cruft
*.tmp
*.swp
.DS_Store

# Python bytecode (scripts/lib/*.py is imported from the source tree)
__pycache__/
scripts/quota_resume_state.*.json
scripts/quota_resume.log
scripts/quota_resume.*.log

# Per-host overlays (config.<host>.json) are host data: this repo is public. They live untracked in the synced tree
# (each host reads only its own); the derivation of each host's floors goes in scratch/memory-floors-*.md.
/config.*.json

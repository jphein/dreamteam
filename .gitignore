# Runtime state — regenerated by hooks each session (roster, footprint log,
# active marker, handoff). Only the placeholder keeps the dir in git.
state/*
!state/.gitkeep

# Editor / OS cruft
*.tmp
*.swp
.DS_Store

# Python bytecode (scripts/lib/*.py is imported from the source tree)
__pycache__/
scripts/quota_resume_state.*.json
scripts/quota_resume.log
